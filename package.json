{
  "name": "six-sigma-study-app",
  "version": "0.8.11-beta.0",
  "private": true,
  "workspaces": [
    "apps/reader"
  ],
  "scripts": {
    "dev": "npm --workspace apps/reader run dev",
    "build": "npm --workspace apps/reader run build",
    "typecheck": "npm --workspace apps/reader run typecheck",
    "stage:private-question-bank": "python scripts/stage_private_question_bank.py",
    "clean:private-question-bank": "python scripts/stage_private_question_bank.py clean",
    "android:sync": "python scripts/sync_android.py",
    "android:apk": "npm run android:sync && cd android && gradlew.bat assembleDebug",
    "android:release-apk": "npm run android:sync && cd android && gradlew.bat assembleRelease",
    "android:aab": "npm run android:sync && cd android && gradlew.bat bundleRelease",
    "extract:ch01": "python scripts/extract_chapter_content.py",
    "extract:manual": "python scripts/extract_manual_content.py",
    "apply:content-overrides": "python scripts/apply_content_overrides.py",
    "apply:context-corrections": "python scripts/apply_context_corrections.py",
    "validate:context-corrections": "python scripts/qa_context_corrections.py",
    "qa:context-corrections": "python scripts/qa_context_corrections.py",
    "qa:ai-context-ui": "node scripts/qa-ai-context-ui-cdp.mjs",
    "qa:android-keystore": "node scripts/qa-android-deepseek-keystore-cdp.mjs",
    "qa:android-back-stack": "node scripts/qa-android-back-stack-cdp.mjs",
    "qa:native-study-assist": "node scripts/qa-native-study-assist-cdp.mjs",
    "build:dictionary": "python scripts/build_manual_dictionary.py",
    "build:context-glosses": "python scripts/build_context_glosses.py",
    "lint:content": "python scripts/validate_content.py content/processed",
    "lint:books": "python scripts/import_book_agent_contract.py validate --require-sample",
    "qa:book-import": "python scripts/import_book_agent_contract.py sample",
    "audit:public": "python scripts/audit_public_ready.py",
    "docs:links": "python scripts/check_docs_links.py",
    "qa:source-coverage": "python scripts/qa_source_coverage.py",
    "qa:content-fidelity": "python scripts/qa_content_fidelity.py",
    "qa:content-fidelity-reviewed": "python scripts/qa_content_fidelity.py --strict-reviewed",
    "qa:multibook-ux": "node scripts/qa-multibook-ux-cdp.mjs",
    "qa:target3-product": "node scripts/qa-multibook-ux-cdp.mjs",
    "qa:target4-flow": "node scripts/qa-target4-flow-cdp.mjs",
    "qa:notes": "node scripts/qa-notes-cdp.mjs",
    "qa:sheet-gestures": "node scripts/qa-multibook-ux-cdp.mjs",
    "qa:image-fidelity": "node scripts/qa-android-key-chapters-cdp.mjs",
    "qa:android-key-chapters": "node scripts/qa-android-key-chapters-cdp.mjs",
    "qa:vocab-flashcards": "node scripts/qa-vocab-flashcards.mjs",
    "qa:vocab-study-ux": "node scripts/qa-vocab-study-ux-cdp.mjs",
    "qa:context-lookup": "node scripts/qa-context-lookup.mjs",
    "qa:context-glosses": "python scripts/qa_context_glosses.py",
    "qa:lexical-learning": "node scripts/qa-lexical-learning.mjs",
    "qa:dictionary-boundaries": "python scripts/qa_dictionary_lookup_boundaries.py",
    "qa:streak": "node scripts/qa-streak.mjs",
    "qa:question-schema": "python scripts/qa_question_schema.py",
    "qa:question-modes": "node scripts/qa-question-modes.mjs",
    "qa:learning-ui": "node scripts/qa-learning-ui-cdp.mjs",
    "qa:lexical-ui": "node scripts/qa-lexical-ui-cdp.mjs",
    "qa:motion-ui": "node scripts/qa-motion-ui-cdp.mjs",
    "qa:motion-continuity": "node scripts/qa-motion-continuity-cdp.mjs",
    "qa:transition-resilience": "node scripts/qa-transition-resilience-cdp.mjs",
    "qa:maturity-regressions": "node scripts/qa-maturity-regressions-cdp.mjs",
    "qa:private-isolation": "python scripts/qa_private_question_bank_isolation.py",
    "qa:public-artifact": "python scripts/qa_public_artifact.py",
    "qa:learning-modules": "npm run qa:vocab-flashcards && npm run qa:context-lookup && npm run qa:context-glosses && npm run qa:lexical-learning && npm run qa:dictionary-boundaries && npm run qa:streak && npm run qa:question-schema && npm run qa:question-modes && npm run qa:private-isolation && npm run qa:public-artifact && npm run qa:context-corrections"
  },
  "devDependencies": {
    "@capacitor/android": "^8.4.1",
    "@capacitor/cli": "^8.4.1",
    "@capacitor/core": "^8.4.1"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.0"
  }
}
